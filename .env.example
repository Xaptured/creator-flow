# --- PostgreSQL ---
POSTGRES_DB=creatorflow
POSTGRES_USER=creatorflow
POSTGRES_PASSWORD=change_me_postgres

# --- Redis ---
REDIS_PASSWORD=change_me_redis
REDIS_MAX_MEMORY=256mb

# --- Spring Boot: DataSource ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=creatorflow
DB_USERNAME=creatorflow
DB_PASSWORD=change_me_postgres

# --- Spring Boot: Redis ---
REDIS_HOST=localhost
REDIS_PORT=6379

# --- Spring Boot: Server ---
SERVER_PORT=8081   # optional — defaults to 8081 if not set

# --- Spring Boot: Security (dev only — replaced by Keycloak in Phase 1) ---
SPRING_SECURITY_USER_NAME=change_me_username
SPRING_SECURITY_USER_PASSWORD=change_me_password
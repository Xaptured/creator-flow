# =============================================================================
# CREATORFLOW — .gitignore (minimal — expand as needed per phase)
# =============================================================================


# Java / Spring Boot
target/
*.class
*.jar
*.war

# Node / Next.js
node_modules/
.next/
.pnpm-store/

# Python / FastAPI
__pycache__/
*.pyc
.venv/
venv/

# Terraform
infra/.terraform/
*.tfstate
*.tfstate.*
*.tfvars

# Environment & secrets — NEVER commit these
.env
.env.*
!.env.example
*.pem
*.key

# IDE
.idea/
.vscode/
*.iml

# OS
.DS_Store
Thumbs.db

# Logs
*.log
logs/

.agents/
.agents/skills/
.claude/
skills-lock.json
deployment-ci/

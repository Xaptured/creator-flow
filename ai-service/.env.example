PORT=8085

DB_HOST=localhost
DB_PORT=5432
DB_NAME=creatorflow
DB_USERNAME=
DB_PASSWORD=
DB_SSL=false

INTERNAL_API_KEY=

KEYCLOAK_ISSUER_URI=http://localhost:8080/realms/creatorflow

# Anthropic — text generation (insights, best-time recommendation)
ANTHROPIC_API_KEY=

# OpenAI — embeddings (text-embedding-3-small = 1536 dims, matches V17 schema)
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536


AWS_REGION=ap-south-1
AI_PROCESSING_QUEUE_URL=http://localhost:4566/000000000000/ai-processing-queue
AWS_SQS_ENDPOINT=http://localhost:4566
DISABLE_SQS_POLLING=false

YOUTUBE_API_KEY=
TRENDING_YOUTUBE_ENABLED=true

IG_APP_ACCESS_TOKEN=
IG_BUSINESS_USER_ID=
TRENDING_INSTAGRAM_ENABLED=true

X_API_BEARER_TOKEN=
TRENDING_X_ENABLED=false

TRENDING_DEFAULT_REGION=US
TRENDING_FRESHNESS_HOURS=48
TRENDING_REFRESH_CRON=0 */6 * * *
TRENDING_X_REFRESH_CRON=0 3 * * *
DISABLE_TRENDING_CRON=false

OPENAI_EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIM=1536


AWS_REGION=ap-south-1
AI_PROCESSING_QUEUE_URL=http://localhost:4566/000000000000/ai-processing-queue
AWS_SQS_ENDPOINT=http://localhost:4566
DISABLE_SQS_POLLING=false

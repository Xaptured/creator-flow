# --- Feature flags ---
# CF-112: false ships the public landing page only. Login UI is hidden and every
# non-public path (/login, /dashboard/*, /api/*) returns 404.
# CF-130 flips this to true once Keycloak and the backend services are reachable.
# NEXT_PUBLIC_ is inlined at build time - changing it requires a rebuild.
NEXT_PUBLIC_AUTH_ENABLED=true

# --- Auth.js v5 + Keycloak (not required when NEXT_PUBLIC_AUTH_ENABLED=false) ---
# Names follow the Auth.js v5 provider convention - do not rename.
AUTH_KEYCLOAK_ID=creatorflow-frontend
AUTH_KEYCLOAK_SECRET=change_me
AUTH_KEYCLOAK_ISSUER=http://localhost:8080/realms/creatorflow
# Generate with: npx auth secret
AUTH_SECRET=change_me

# --- Backend service URLs (server-side only - no NEXT_PUBLIC_ prefix) ---
# The browser never calls these directly; it calls Next.js routes under /api/*,
# which call the services server-to-server. Do not add NEXT_PUBLIC_ to these.
MEDIA_SERVICE_URL=http://localhost:8082/creator-flow/media
AUTH_SERVICE_URL=http://localhost:8081/creator-flow/auth
SCHEDULER_SERVICE_URL=http://localhost:8084/creator-flow/scheduler
ANALYTICS_SERVICE_URL=http://localhost:8083/creator-flow/analytics
AI_SERVICE_URL=http://localhost:8085

# --- Logging ---
LOG_LEVEL=info

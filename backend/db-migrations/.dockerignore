# =============================================================================
# db-migrations build context exclusions.
# Mirror of backend/auth-service/.dockerignore — keep the two in sync.
# See docs/docker-standards.md § .dockerignore.
# =============================================================================

# --- Build output ------------------------------------------------------------
target/
*.jar
*.war
*.class

# --- VCS ---------------------------------------------------------------------
.git/
.gitignore
.gitattributes

# --- Maven wrapper (unused: the build stage uses the maven base image) -------
.mvn/
mvnw
mvnw.cmd

# --- Tests (executed in CI, never in the image build) ------------------------
src/test/

# --- IDE / editor ------------------------------------------------------------
.idea/
*.iml
*.ipr
*.iws
.vscode/
.settings/
.project
.classpath
*.swp
*~

# --- Docs --------------------------------------------------------------------
*.md
docs/

# --- Local config and secrets (must never enter an image layer) --------------
# Patterns match relative to the CONTEXT ROOT, so a bare `*.key` would NOT
# match src/main/resources/foo.key. The `**/` prefix is what makes these
# recursive — without it this whole block is decorative, and src/ is exactly
# where a stray credential file would sit.
.env
.env.*
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/*.keystore
**/application-local.yml
**/application-local.yaml
**/application-local.properties
**/*credentials*.json
**/*service-account*.json

# --- OS noise ----------------------------------------------------------------
.DS_Store
Thumbs.db

# --- Docker itself -----------------------------------------------------------
Dockerfile
.dockerignore
